{
  "name": "NCI_Report_Writer",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.config.json",
    "build": "ng build && npm run copyAll",
    "build:prod": "ng build --configuration production --base-href /ncireportwriter2/ && npm run copyAll",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "ng e2e",
    "copyAll": "cp -r dist/* ../web/src/main/resources/static/",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.35",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/localize": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@angular/router": "^20.3.35",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@popperjs/core": "2.11.8",
    "@primeuix/themes": "^2.0.3",
    "bootstrap": "^4.5.0",
    "font-awesome": "^4.7.0",
    "jquery": "^3.6.0",
    "ngx-toastr": "^16.2.0",
    "primeicons": "^6.0.1",
    "primeng": "^20.4.0",
    "rxjs": "^7.4.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.35",
    "@angular/language-service": "^20.3.35",
    "@cypress/schematic": "^4.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^12.11.1",
    "cypress": "^15.10.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "ts-node": "~3.2.0",
    "typescript": "5.8.3"
  },
  "overrides": {
    "webpack": "^5.94.0",
    "tar": "^7.5.9",
    "ajv": "^8.18.0",
    "rollup": "^4.59.0",
    "serialize-javascript": "^7.0.3",
    "minimatch": "^11.0.9",
