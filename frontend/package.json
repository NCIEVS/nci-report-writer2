{
  "name": "NCI_Report_Writer",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.config.json",
    "build": "ng build && npm run copyAll",
    "build:prod": "ng build --prod --base-href /ncreportwriter/ && npm run copyAll",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "copyAll": "cp -r dist/* ../web/src/main/resources/static/"
  },
  "browserify-shim": {
    "angular": {
      "exports": "angular"
    },
    "angular-local-storage": {
      "exports": "angular.module('LocalStorageModule').name"
    }
  },
  "browserify": {
    "transform": [
      "browserify-shim"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "12.2.18",
    "@angular-devkit/schematics": "12.2.18",
    "@angular/animations": "^12.2.17",
    "@angular/cdk": "^12.2.13",
    "@angular/common": "^12.2.17",
    "@angular/compiler": "^12.2.17",
    "@angular/core": "^12.2.17",
    "@angular/forms": "^12.2.17",
    "@angular/platform-browser": "^12.2.17",
    "@angular/platform-browser-dynamic": "^12.2.17",
    "@angular/router": "^12.2.17",
    "@fullcalendar/core": "^6.1.18",
    "@ng-bootstrap/ng-bootstrap": "^10.0.0",
    "bootstrap": "^4.5.0",
    "chart.js": "^4.5.0",
    "core-js": "^2.5.7",
    "font-awesome": "^4.7.0",
    "jquery": "^3.2.1",
    "ngx-toastr": "^14.3.0",
    "npm": "^7.24.2",
    "popper.js": "^1.14.4",
    "primeicons": "^1.0.0-beta.9",
    "primeng": "^12.2.3",
    "quill": "^2.0.3",
    "rxjs": "^6.5.3",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^12.2.18",
    "@angular/cli": "^12.2.18",
    "@angular/compiler-cli": "^12.2.17",
    "@angular/language-service": "^12.2.17",
    "@types/jasmine": "~2.5.53",
    "@types/jasminewd2": "^2.0.5",
    "@types/node": "^12.11.1",
    "browserify": "^15.1.0",
    "browserify-shim": "^3.8.14",
    "codelyzer": "^5.1.2",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-cli": "~1.0.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "ts-node": "~3.2.0",
    "tslint": "~6.1.0",
    "typescript": "4.3.5"
  }
}
