[Unit]
Description=ncireportwriter
After=network-online.target

[Service]
User=evsuser
Group=evsuser
Environment=JAVA_HOME=/usr/local/corretto-jdk17
ExecStart=/local/content/ncireportwriter2/ncireportwriter2/bin/ncireportwriter2 start
ExecStop=/local/content/ncireportwriter2/ncireportwriter2/bin/ncireportwriter2 stop
WorkingDirectory=/local/content/ncireportwriter2/ncireportwriter2/bin
Type=forking
#Restart=always
Restart=on-failure

[Install]
WantedBy=multi-user.target